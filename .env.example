# Server configuration
PORT=3001
NODE_ENV=development

# Authentication
# In production, set a strong, random 256-bit secret string (e.g. openssl rand -hex 32)
JWT_SECRET=

# Optional server-side admin creation at startup (useful when hosting has no Shell).
# Set a private ADMIN_PASSWORD in your hosting dashboard, never in this file.
BOOTSTRAP_ADMIN=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# PostgreSQL / Supabase (backend only). Leave DATABASE_URL empty for local SQLite.
# Copy the Session pooler URI from Supabase Connect; never commit the real URI.
DATABASE_URL=
# Set true on Render to prevent falling back to temporary SQLite if URL is missing.
REQUIRE_DATABASE_URL=false
# Optional PEM CA certificate from Supabase (literal newlines or escaped \n).
DATABASE_CA_CERT=
